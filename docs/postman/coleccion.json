{
  "info": {
    "name": "SGROAS API",
    "description": "Coleccion de pruebas para la API de SGROAS - Tercera Entrega",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "sgroas-team"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "conductor_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login exitoso",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('access_token', json.accessToken);",
                  "pm.collectionVariables.set('refresh_token', json.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@sgroas.com\",\"password\":\"admin123\"}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login credenciales invalidas (401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@sgroas.com\",\"password\":\"wrong\"}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login payload invalido (422 ProblemDetails)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"\"}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login inyeccion SQL (422 ProblemDetails)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"' OR 1=1 --\",\"password\":\"cualquier\"}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\":\"Nuevo Usuario\",\"email\":\"nuevo@sgroas.com\",\"password\":\"123456\",\"rol\":\"ROLE_COORDINADOR\"}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"refreshToken\":\"{{refresh_token}}\"}"
            },
            "url": { "raw": "{{base_url}}/api/auth/refresh", "host": ["{{base_url}}"], "path": ["api", "auth", "refresh"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"refreshToken\":\"{{refresh_token}}\"}"
            },
            "url": { "raw": "{{base_url}}/api/auth/logout", "host": ["{{base_url}}"], "path": ["api", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Conductores",
      "item": [
        {
          "name": "Listar conductores (auth)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/conductores", "host": ["{{base_url}}"], "path": ["api", "conductores"] }
          }
        },
        {
          "name": "Listar conductores (sin auth - 401/403)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/conductores", "host": ["{{base_url}}"], "path": ["api", "conductores"] }
          }
        },
        {
          "name": "Crear conductor exitoso",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('conductor_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nombres\":\"Carlos Alberto\",\"apellidos\":\"Mendoza Vera\",\"cedula\":\"1200000001\",\"numeroLicencia\":\"LIC-001-2026\",\"tipoLicencia\":\"E\",\"fechaVencimientoLicencia\":\"2026-12-31\",\"telefono\":\"0988888888\",\"email\":\"carlos@sgroas.com\",\"estado\":\"ACTIVO\"}"
            },
            "url": { "raw": "{{base_url}}/api/conductores", "host": ["{{base_url}}"], "path": ["api", "conductores"] }
          }
        },
        {
          "name": "Crear conductor cedula duplicada (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nombres\":\"Otro\",\"apellidos\":\"Conductor\",\"cedula\":\"1200000001\",\"numeroLicencia\":\"LIC-002-2026\",\"tipoLicencia\":\"B\",\"fechaVencimientoLicencia\":\"2026-12-31\",\"telefono\":\"0999999999\",\"email\":\"otro@sgroas.com\",\"estado\":\"ACTIVO\"}"
            },
            "url": { "raw": "{{base_url}}/api/conductores", "host": ["{{base_url}}"], "path": ["api", "conductores"] }
          }
        },
        {
          "name": "Crear conductor datos invalidos (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nombres\":\"\",\"apellidos\":\"\",\"cedula\":\"123\",\"numeroLicencia\":\"\",\"tipoLicencia\":\"\",\"fechaVencimientoLicencia\":\"\",\"telefono\":\"\",\"email\":\"\",\"estado\":\"\"}"
            },
            "url": { "raw": "{{base_url}}/api/conductores", "host": ["{{base_url}}"], "path": ["api", "conductores"] }
          }
        },
        {
          "name": "Obtener conductor por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/conductores/{{conductor_id}}", "host": ["{{base_url}}"], "path": ["api", "conductores", "{{conductor_id}}"] }
          }
        },
        {
          "name": "Obtener conductor no existente (404)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/conductores/99999", "host": ["{{base_url}}"], "path": ["api", "conductores", "99999"] }
          }
        },
        {
          "name": "Actualizar conductor",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nombres\":\"Carlos A.\",\"apellidos\":\"Mendoza V.\",\"cedula\":\"1200000001\",\"numeroLicencia\":\"LIC-001-2026\",\"tipoLicencia\":\"E\",\"fechaVencimientoLicencia\":\"2027-06-15\",\"telefono\":\"0988888888\",\"email\":\"carlos.m@sgroas.com\",\"estado\":\"ACTIVO\"}"
            },
            "url": { "raw": "{{base_url}}/api/conductores/{{conductor_id}}", "host": ["{{base_url}}"], "path": ["api", "conductores", "{{conductor_id}}"] }
          }
        },
        {
          "name": "Actualizar conductor datos invalidos (422)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nombres\":\"\",\"cedula\":\"\"}"
            },
            "url": { "raw": "{{base_url}}/api/conductores/{{conductor_id}}", "host": ["{{base_url}}"], "path": ["api", "conductores", "{{conductor_id}}"] }
          }
        },
        {
          "name": "Eliminar conductor (logico)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/conductores/{{conductor_id}}", "host": ["{{base_url}}"], "path": ["api", "conductores", "{{conductor_id}}"] }
          }
        }
      ]
    },
    {
      "name": "Documentacion",
      "item": [
        {
          "name": "Swagger UI",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/docs/swagger-ui.html", "host": ["{{base_url}}"], "path": ["api", "docs", "swagger-ui.html"] }
          }
        },
        {
          "name": "OpenAPI JSON",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/docs", "host": ["{{base_url}}"], "path": ["api", "docs"] }
          }
        }
      ]
    },
    {
      "name": "Rate Limiting",
      "item": [
        {
          "name": "Login rate limit (6 intentos -> 429)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@sgroas.com\",\"password\":\"wrong\"}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    }
  ]
}
